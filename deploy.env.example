# Template for deploy.env, the settings ./deploy.sh reads. Copy it and fill in
# the placeholders:
#   cp deploy.env.example deploy.env
# deploy.env itself is git-ignored — it holds this machine's values and must
# never be committed. See DEPLOYMENT_CHEATSHEET.md for the full runbook.

# Public hostname the game is served from.
export HOST=app.ericrxu.com

# The Droplet's address: `doctl compute droplet list --format Name,PublicIPv4`.
export DROPLET_IP='<your-droplet-address>'

# Where the game lives on HOST. The release layout supports only /tilesense/.
export BASE_HREF=/tilesense/

# Managed Postgres cluster ID: `doctl databases list --format ID,Name`.
# Needed by migrate / ingest / geoip / all.
export DB_ID='<managed-postgres-id>'

# Exact Dart SDK image for the ingest and multiplayer builds (ingest / mp /
# all). A fixed version on purpose, not dart:stable — change it only when you
# deliberately move to a new SDK. A digest may be appended: dart:X.Y.Z@sha256:…
export DART_IMAGE=dart:3.13.3

# Not settings — per-run acknowledgements, so keep them OUT of this file and
# type them on the command line when you mean them:
#   ALLOW_MP_RESTART=1 ./deploy.sh mp     # mp and all drop live online rooms;
#                                         # at a terminal, Enter at the prompt
#                                         # does the same
#   ALLOW_DIRTY_DEPLOY=1 ./deploy.sh ...  # build from uncommitted changes
#
# No longer read by deploy.sh: SERVED_DIR (safe to delete), and DROPLET_ID —
# keep that one if you follow the manual firewall steps in
# server/DEPLOYMENT.md, which still use it.
