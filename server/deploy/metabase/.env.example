# Copy to .env next to docker-compose.yml and `chmod 600 .env`.

# Pin an actual release — do NOT track :latest in production.
# Latest: curl -s https://api.github.com/repos/metabase/metabase/releases/latest \
#           | grep -oE '"tag_name": *"[^"]+"'
MB_VERSION=v0.52.8

# Password for Metabase's OWN app database (the `db` service in the compose file).
# Generate once:  openssl rand -hex 24
MB_DB_PASSWORD=

# Public URL nginx serves Metabase at — used for links, redirects, and to stop
# the "different URL" warning.
MB_SITE_URL=https://analytics.app.ericrxu.com

# JVM heap cap. -Xmx1g is safe on a 2 GB droplet (or 1 GB + swap). Raise on
# a bigger box (e.g. -Xmx2g).
MB_JAVA_OPTS=-Xmx1g
