# /etc/systemd/system/tilesense-ingest.service
[Unit]
Description=TileSense telemetry ingest
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/tilesense-ingest.env
ExecStart=/usr/local/bin/tilesense-ingest
Restart=always
RestartSec=2
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=128M

[Install]
WantedBy=multi-user.target
