# /etc/systemd/system/tilesense-mp.service
#
# Restarting this service drops every room in memory. See server/DEPLOYMENT.md
# section 3 for multiplayer deployment details.
[Unit]
Description=TileSense multiplayer game server
After=network-online.target
Wants=network-online.target

[Service]
Environment=PORT=8789
Environment=BIND_ADDR=127.0.0.1
# Bot Saeko plays Mortal's moves in riichi and sanma rooms
# (server/mp/lib/mortal.dart); with a sidecar down or absent she falls back
# to SimpleBot.
Environment=MORTAL_URL=http://127.0.0.1:8790
Environment=MORTAL_SANMA_URL=http://127.0.0.1:8791
# Bot Nagomi plays the fine-tuned model in four-player riichi rooms, hanchan
# or East only; with this unset or the sidecar down she plays Saeko's Mortal,
# then SimpleBot. Remove the line to turn her model off.
Environment=MORTAL_NAGOMI_URL=http://127.0.0.1:8792
ExecStart=/usr/local/bin/tilesense-mp
Restart=always
RestartSec=2
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=128M

[Install]
WantedBy=multi-user.target
