# Copy to .env and fill in. The service reads these from the process environment
# (systemd EnvironmentFile, App Platform env vars, or `set -a; . ./.env`).

# Local dev (matches docker-compose.yml):
DATABASE_URL=postgres://tilesense:devpassword@localhost:5432/tilesense?sslmode=disable

# Production (DO Managed Postgres): copy the URI from `doctl databases connection`
# — it already ends with ?sslmode=require.
# DATABASE_URL=postgres://doadmin:...@db-...ondigitalocean.com:25060/defaultdb?sslmode=require

# Pseudonymises the caller IP. Generate once, keep secret, never rotate casually
# (rotating changes every ip_hmac): openssl rand -hex 32
IP_HMAC_SECRET=replace-me-with-32-plus-random-bytes

# CORS origin to echo. Same-origin deploys (recommended) don't need this; set it
# if the client is served from a different host.
ALLOW_ORIGIN=*

PORT=8787
# Listen address. Default 127.0.0.1 (Nginx on the same box proxies to it).
# Set 0.0.0.0 only behind a platform router that reaches the container by IP
# (DO App Platform does this — see deploy/app-platform.yaml).
# BIND_ADDR=0.0.0.0
