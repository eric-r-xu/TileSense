# Copy to ~/.dbt/profiles.yml. Point at a read replica or a restore, never at
# the ingest role: dbt only needs read on `public` and create on its own schemas.
tilesense:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('DBT_PG_HOST', 'localhost') }}"
      port: "{{ env_var('DBT_PG_PORT', '5432') | int }}"
      user: "{{ env_var('DBT_PG_USER') }}"
      password: "{{ env_var('DBT_PG_PASSWORD') }}"
      dbname: "{{ env_var('DBT_PG_DB', 'tilesense') }}"
      schema: dbt_dev
      threads: 4
