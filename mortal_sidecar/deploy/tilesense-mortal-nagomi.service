# /etc/systemd/system/tilesense-mortal-nagomi.service
#
# The fine-tuned model for bot Nagomi in multiplayer four-player riichi (see
# ../server.py, ../model_nagomi.json) on 127.0.0.1:8792: multiplayer asks it
# directly, the app's offline riichi games through nginx-mortal-nagomi.conf.
# Stateless, so a restart loses nothing: Nagomi plays Saeko's Mortal (:8790),
# then SimpleBot, for the few seconds it takes. Capped like the other sidecars so it can never starve the
# site, ingest or multiplayer on the shared 1 vCPU / 2 GB droplet; it is a
# third process of about the same size as the 4-player one (~170 MB peak).
[Unit]
Description=TileSense Mortal sidecar (bot Nagomi's fine-tuned model)
After=network-online.target
Wants=network-online.target

[Service]
Environment=OMP_NUM_THREADS=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/tilesense-mortal-nagomi/current/venv/bin/python /opt/tilesense-mortal-nagomi/current/server.py --model /opt/tilesense-mortal-nagomi/current/mortal.onnx --host 127.0.0.1 --port 8792
Restart=always
RestartSec=2
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryHigh=250M
MemoryMax=300M
CPUQuota=40%
Nice=10

[Install]
WantedBy=multi-user.target
