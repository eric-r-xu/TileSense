  "tourStepOf": "{total} में से {step}",
  "builderTourPaletteTitle": "अपनी टाइलें चुनें",
  "builderTourPaletteBody": "टेबल का जो हिस्सा आप भर रहे हैं, उसमें जोड़ने के लिए किसी टाइल पर टैप करें। हर टाइल के नीचे छोटी संख्या बताती है कि कितनी प्रतियाँ बची हैं; जिसकी कोई न बची हो वह धुँधली हो जाती है, ताकि टेबल पर किसी भी टाइल की चार से अधिक न हों।",
  "builderTourContentsTitle": "आपने क्या रखा है",
  "builderTourContentsBody": "टेबल के चुने हुए हिस्से की टाइलें यहाँ सूचीबद्ध हैं। किसी को वापस हटाने के लिए उस पर टैप करें।",
  "builderTourChipsTitle": "चुनें कि क्या भरना है",
  "builderTourChipsBody": "ये चिप्स चुनते हैं कि अगली टाइल कहाँ जाएगी: आपका हाथ, पेश की गई टाइल, डोरा या फूल, और हर खिलाड़ी के डिस्कार्ड और कॉल। शुरुआत में आपका हाथ चुना होता है।",
  "builderTourTableTitle": "टेबल साथ-साथ चलती है",
  "builderTourTableBody": "आप जो भी रखते हैं वह टेबल पर दिखता है। भरना शुरू करने के लिए आप टेबल पर ही किसी डिस्कार्ड क्षेत्र, कॉल क्षेत्र या डोरा पर भी टैप कर सकते हैं।",
  "builderTourStatusTitle": "क्या टेबल तैयार है?",
  "builderTourStatusBody": "यह पंक्ति बताती है कि टेबल को आगे क्या चाहिए। 13 टाइलों पर कॉल विश्लेषण, 14वीं टाइल पर डिस्कार्ड विश्लेषण, और पूरा हाथ बनाने वाली 14 टाइलें जीत के रूप में स्कोर होती हैं।",
  "builderTourGuideTitle": "TileSensor का विश्लेषण",
  "builderTourGuideBody": "गाइड पैनल आपकी टेबल पढ़ता है: हर डिस्कार्ड को रैंक करता है, या जीतने वाले हाथ को स्कोर करता है। हर बार टाइल जोड़ने या हटाने पर यह अपडेट होता है।",
  "builderTourSample": "एक नमूना हाथ आज़माएँ",
  "builderTourMenuTitle": "टेबल सेटअप",
