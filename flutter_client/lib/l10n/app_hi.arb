  "glossaryTitle": "शब्दावली",
  "glossarySearchHint": "शब्द खोजें",
  "glossaryNoMatch": "आपकी खोज से कोई शब्द मेल नहीं खाता।",
  "glossaryUnitHan": "हान",
  "glossaryUnitFaan": "फ़ान",
  "glossaryUnitTai": "ताई",
  "glossaryUnitFan": "फ़ान",
  "glossaryTermSet": "सेट",
  "glossaryDefSet": "तीन टाइलें जो साथ जाती हैं: एक सूट में तीन का क्रम, या तीन एक जैसी टाइलें। चार एक जैसी टाइलें भी कोंग के रूप में गिनी जाती हैं।",
  "glossaryTermPair": "जोड़ा",
  "glossaryDefPair": "दो एक जैसी टाइलें। जीतने वाला हाथ चार सेट और ठीक एक जोड़ा होता है।",
  "glossaryDefChi": "एक सूट में तीन का क्रम पूरा करने के लिए दूसरे खिलाड़ी का डिस्कार्ड लें। केवल बाएँ वाले खिलाड़ी से; सेट फिर खुला दिखाया जाता है।",
  "glossaryDefPon": "किसी भी खिलाड़ी से ऐसा डिस्कार्ड लें जो आपके हाथ की दो टाइलों से मेल खाए, ताकि तीन एक जैसी बनें। सेट खुला दिखाया जाता है।",
  "glossaryDefKan": "चार एक जैसी टाइलें। फिर आप दीवार के अंत से एक प्रतिस्थापन टाइल खींचते हैं।",
  "glossaryTermDiscard": "डिस्कार्ड",
  "glossaryDefDiscard": "वह टाइल जो आप अपनी बारी के अंत में फेंकते हैं, आपके सामने खुली। दूसरे खिलाड़ी उसे ले सकते हैं।",
  "glossaryDefTsumo": "ख़ुद खींची गई टाइल पर जीतना।",
  "glossaryDefRon": "दूसरे खिलाड़ी द्वारा डिस्कार्ड की गई टाइल पर जीतना।",
  "glossaryTermDealer": "डीलर",
  "glossaryDefDealer": "पूर्व में बैठा खिलाड़ी, जो पहले खेलता है। जीतने पर आमतौर पर डीलर अगले हाथ के लिए भी सीट रखता है।",
  "glossaryTermWinds": "हवाएँ",
  "glossaryDefWinds": "चार टाइलें: पूर्व, दक्षिण, पश्चिम और उत्तर। ये सीटों और राउंड के नाम भी हैं, और आपकी सीट हवा या राउंड हवा का सेट अतिरिक्त मूल्य का हो सकता है।",
  "glossaryTermDragons": "ड्रैगन",
  "glossaryDefDragons": "तीन टाइलें: सफ़ेद, हरा और लाल। किसी भी ड्रैगन का सेट अतिरिक्त मूल्य का है।",
  "glossaryTermFlowers": "फूल",
  "glossaryDefFlowers": "बोनस टाइलें। जब आप एक खींचते हैं, उसे दिखाते हैं और दीवार से प्रतिस्थापन लेते हैं। हर एक जीतने वाले हाथ का स्कोर बढ़ा सकती है।",
  "glossaryTermVoid": "शून्य सूट",
  "glossaryDefVoid": "शुरुआत में आप तीन सूटों में से एक छोड़ देते हैं। उसकी कोई भी टाइल रखने वाला हाथ नहीं जीत सकता, और ड्रॉ के बाद बची ऐसी टाइलों पर बड़ा दंड लगता है।",
  "glossaryDefScore": "जीतने वाला हाथ जो कमाता है। अधिक का अर्थ अधिक मूल्यवान हाथ। कुछ टेबल न्यूनतम तय करती हैं जिस तक हाथ को जीतने से पहले पहुँचना होता है।",
  "glossaryTermRiichi": "रीची",
  "glossaryDefRiichi": "1,000 अंक दाँव पर लगाकर जीत से एक टाइल दूर बंद हाथ घोषित करें। फिर आपका हाथ लॉक हो जाता है: आप केवल खींची गई टाइल ही डिस्कार्ड कर सकते हैं। इससे अतिरिक्त स्कोर मिलता है।",
  "glossaryTermDora": "डोरा",
  "glossaryDefDora": "टेबल पर एक संकेतक टाइल द्वारा चुनी गई बोनस टाइलें। जीतने वाले हाथ में हर एक एक हान जोड़ती है।",
  "glossaryTermFuriten": "फ़ुरितेन",
  "glossaryDefFuriten": "अगर आपका हाथ पूरा करने वाली टाइल आपके अपने डिस्कार्ड में है, तो आप डिस्कार्ड से नहीं जीत सकते। स्वयं-खींच से अब भी जीत होती है।",
  "glossaryTermReady": "तैयार हाथ",
  "glossaryDefReady": "जीत से एक टाइल दूर हाथ। गाइड दिखाता है कि कौन सी टाइलें इसे पूरा करेंगी।",
  "glossaryTermAway": "टाइलें दूर",
  "glossaryDefAway": "जीतने से पहले आपके हाथ को और कितनी टाइलें चाहिए। एक टाइल दूर का अर्थ तैयार है। गाइड का मीटर और उसका दूरी या शांतेन कॉलम इसे दिखाते हैं।",
  "glossaryTermHelpful": "मददगार टाइलें",
  "glossaryDefHelpful": "वे टाइलें जो आप खींच सकते हैं और जो आपके हाथ को जीत के क़रीब लाती हैं। गाइड गिनता है कि कितनी अब भी अनदेखी हैं।",
